# DeployCheck: example environment variables
# Copy to .env and adjust. Never commit a real .env file or real secrets.

# --- Web frontend (artifacts/deploycheck, Vite dev server) ---
# Port the Vite dev server listens on (required by vite.config.ts)
PORT=5173
# URL base path the frontend is served from
BASE_PATH=/

# --- API (artifacts/api-server) ---
# The Python scanner API reads no environment variables itself.
# Start it with: uv run uvicorn deploycheck_api.main:app --app-dir artifacts/api-server --port 8080

# --- Optional ---
# Log verbosity for the TypeScript logger (e.g. debug, info, warn, error)
LOG_LEVEL=info

# Only needed if you use the optional database package in lib/db (not used by the scanner)
# DATABASE_URL=postgresql://user:password@localhost:5432/deploycheck
